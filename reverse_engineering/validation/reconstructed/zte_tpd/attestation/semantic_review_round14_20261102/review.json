    {
      "id": "input-device-mutex-balanced",
      "category": "synchronization",
      "severity": "NO_LOCK_LEAK_OR_DOUBLE_UNLOCK_FOUND",
      "disposition": "BOTH_POST_LOCK_EXITS_UNLOCK; ALL_PRELOCK_RETURNS_BYPASS_LOCK",
      "details": "The parameter/cache fast paths return before mutex_lock. After the lock, the successful registration path unlocks before returning 0, and managed-device/allocation/registration errors reach the common unlock path. Ghidra, stock assembly, and candidate C agree.",
      "evidence": {
        "candidate_source_lines": "kernel_development/drivers/reconstructed/zte_tpd/syna_dev_set_up_input_device.c:99,155,174",
        "stock_ghidra_lines": "offline_static/ghidra_stock/decompiled/0166_001136c4_syna_dev_set_up_input_device.c:21,132,140",
        "stock_assembly_calls": "0166_syna_dev_set_up_input_device_001136c4.asm:0xceac mutex_lock; 0xd04c and 0xd0f0 mutex_unlock"
      }
    },
    {
      "id": "managed-input-device-free-after-registration-failure-is-valid",
      "category": "lifetime",
      "severity": "NO_DOUBLE_FREE_FOUND",
      "disposition": "INPUT_CORE_DEVRES_RECORD_DESTROYED_BY_INPUT_FREE_DEVICE",
      "details": "The failure path calls input_free_device only after input_register_device returns an error. In the pinned target kernel implementation, devm_input_allocate_device adds a devres record and marks the input device managed; input_free_device calls devres_destroy for that exact resource before dropping the device reference. This is the documented cleanup path for a failed registration, not a duplicate devres release.",
      "evidence": {
        "target_kernel_repository": "Coding-BR/android_kernel_nubia_sm8850_qwjujube",
        "target_kernel_commit": "3356b35306d35d5a480e3b63df1a9f065b5d9f55",
        "input_core_source": "kernel_platform/common/drivers/input/input.c",
        "input_core_source_sha256": "a06df644d8cb726f28178797bd3b1ec99b4894de5071221deb3e8842e245b526",
        "relevant_lines": "2026-2034, 2054-2078, 2094-2103, 2386-2394"
      }
    },
    {
      "id": "registration-failure-caches-new-parameters-before-device-exists",
      "category": "error_recovery",
      "severity": "CONFIRMED_CONDITIONAL_STOCK_RETRY_SUPPRESSION",
      "disposition": "INHERITED_STOCK_BEHAVIOR_PRESERVED_FOR_OFFLINE_EXACT_RECONSTRUCTION",
      "details": "The function writes the new X/Y/slot values into the cached fields at offsets 0x3b8, 0x3bc, and 0x3c0 before calling input_register_device. If registration fails, it frees the new input object and returns the negative error, while input_device at offset 0x3b0 remains NULL because any old device was already unregistered and cleared. On a later call with the same parameters, the fast path compares only those cached values and returns 0 without checking input_device or retrying registration. Thus a transient registration failure can leave the driver reporting successful setup on re-entry while no input device exists. The same ordering and branch are present in Ghidra and stock AArch64 assembly. This retry scenario was not dynamically exercised.",
      "evidence": {
        "candidate_source_cache_writes": "syna_dev_set_up_input_device.c:143-145",
        "candidate_source_register_and_failure": "syna_dev_set_up_input_device.c:146-165",
        "candidate_source_fast_path": "syna_dev_set_up_input_device.c:71-96",
        "stock_ghidra_cache_then_register": "0166_001136c4_syna_dev_set_up_input_device.c:121-141",
        "stock_assembly_cache_stores": "0xd00c, 0xd014, 0xd01c",
        "stock_assembly_register_call": "0xd020 R_AARCH64_CALL26 input_register_device",
        "stock_assembly_failure_branch": "0xd024 branch on negative return to error cleanup",
        "stock_assembly_early_cache_return": "0166_001136c4_syna_dev_set_up_input_device.asm early parameter comparisons and no-op return before 0xceac mutex_lock",
        "stock_assembly_sha256": "aa5b1d25790b62c3ecf164d3b2a2a2630ecb9f6841878a508bea47e51903351c"
      }
    },
    {
      "id": "dispatcher-error-branch-is-unreachable-for-valid-tcm",
      "category": "error_handling",
      "severity": "NO_REACHABLE_ERROR_CONFIRMED",
      "disposition": "HELPER_RETURNS_ZERO_FOR_NON_NULL_TCM",
      "details": "The caller logs if syna_tcm_set_report_dispatcher returns negative, then returns success. The current helper implementation returns 0 whenever tcm is non-NULL and only returns -241 for a NULL handle; this caller has already dereferenced tcm before that call. The log-only branch is therefore not a reachable failure with the current helper contract.",

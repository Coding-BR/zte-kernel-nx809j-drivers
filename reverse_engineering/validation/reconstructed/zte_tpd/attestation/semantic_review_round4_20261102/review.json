  "findings": [
    {
      "id": "syna-tcm-fw-update-stack-mutex-source-mirror-gap",
      "category": "synchronization",
      "severity": "HIGH_IF_C_MIRROR_IS_COMPILED",
      "disposition": "CORRECTED_IN_C_MIRROR; EXACT_STOCK_ASSEMBLY_ALREADY_INITIALIZED_MUTEX",
      "details": "Stock Ghidra pseudocode calls __mutex_init for the stack mutex before syna_tcm_set_up_flash_access and syna_tcm_update_flash_block. The exact AArch64 assembly has the corresponding __mutex_init relocation. The C mirror had zero-initialized the access context but omitted mutex_init(access.mutex), while the optimized update path locks access->mutex at offset +0x50. Added mutex_init(access.mutex) after the invalid-parameter guard and updated the reconstruction-map source hash. The Makefile selects syna_tcm_do_fw_update_ex_exact.S and filters out the C file, so this was a semantic source-mirror mismatch; the compiled stock-exact path already initialized the mutex.",
      "evidence": {
        "stock_function_entry": "00125c18",
        "ghidra_file": "offline_static/ghidra_stock/decompiled/0301_00125c18_syna_tcm_do_fw_update_ex.c",
        "ghidra_mutex_init_line": 67,
        "exact_assembly": "kernel_development/drivers/reconstructed/zte_tpd/syna_tcm_do_fw_update_ex_exact.S",
        "exact_assembly_mutex_init_relocation_line": 87,
        "context_mutex_offset": "0x50",
        "source_file": "kernel_development/drivers/reconstructed/zte_tpd/syna_tcm_do_fw_update_ex.c",
        "corrected_line": 47
      }
    },
    {
      "id": "syna-tcm-flash-allocation-and-lock-balance",
      "category": "lifetime_and_synchronization",
      "severity": "NO_CONFIRMED_IMBALANCE",
      "disposition": "18_JOERN_CALLSITE_ALERTS_REVIEWED; NO_LOCAL_LEAK_DOUBLE_FREE_OR_LOCK_LEAK_CONFIRMED",
      "details": "In syna_tcm_read_flash_area, replacement allocations and the local lockdown allocation converge on cleanup paths; managed access allocation is released at the common out path. In syna_tcm_read_flash_boot_cs_config, temporary buffers converge on cleanup_temporary across read, resize, bounds, and error paths. In syna_tcm_update_flash_block, the mutex is acquired once and success/error exits release it through mutually exclusive branches; managed buffer resizing occurs while locked and the caller releases it at common cleanup. Ghidra pseudocode shows the same cleanup and branch-exclusive unlock structure. Joern findings are syntactic call-site alerts, not independent vulnerability proofs.",
      "functions": [
        "syna_tcm_read_flash_area",
        "syna_tcm_read_flash_boot_cs_config",
        "syna_tcm_update_flash_block"
      ],

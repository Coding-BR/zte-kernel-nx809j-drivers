  "concurrency_evidence": {
    "irq_registration": "Stock irq_config registers irq_handle as the threaded handler through devm_request_threaded_irq, with a null primary handler and flags 0x2002.",
    "irq_handler_locking": "irq_handle reads state+0x6bc and calls aw8693x_get_irq_state. In its Richtap-active branch (snapshot value 1), it calls richtap_update_fifo_data and FIFO callbacks without acquiring state+0x2f0. The other non-Richtap/audio path uses state+0x370, which does not serialize with the stop worker mutex.",
    "irq_state_and_fifo": "aw8693x_get_irq_state reads I2C register 0x02. richtap_update_fifo_data copies into state+0x608 and updates state+0x620/+0x6b8 while it services RTP data.",
    "stop_worker_locking": "richtap_stop_work, queued by the stop ioctl path, takes state+0x2f0 and invokes aw8693x_irq_clear, aw8693x_stop, then aw8693x_set_rtp_aei(0), finally clearing state+0x6bc. The IRQ handler does not take this mutex in its active Richtap branch.",
    "shared_device_access": "aw8693x_irq_clear also reads I2C register 0x02. aw8693x_stop performs I2C writes to registers 0x45, 0x08 and 0x09 and polls register 0x3f; aw8693x_set_rtp_aei updates register 0x03. The two contexts can therefore overlap state/FIFO and device-operation sequences if an IRQ is serviced while the stop work runs."
  },
  "finding": {
    "id": "HAP-RICHTAP-06",
    "title": "Richtap IRQ FIFO service is not serialized with ioctl stop work",
    "severity": "medium_potential_concurrency",
    "confidence": "moderate_static_lockset_and_callpath",
    "condition": "An active Richtap threaded IRQ handler overlaps the queued state+0x668 stop worker.",
    "impact": "Potential interleaving of FIFO/state updates and stop-related I2C operations. Exact hardware effect and whether the device exposes a user-visible failure are not established.",
    "runtime_reproduced": false,
    "hardware_tested": false,
    "separate_from": "HAP-RICHTAP-03 concerns stop-work lifetime during remove; HAP-RICHTAP-06 concerns lock coverage while the device remains active."
  },

  "teardown_ordering": [
    "vibrator_init creates the generic show/store group on the LED child kobject after registering the managed LED class device.",
    "aw8693x_creat_node creates the AW-specific group on that same LED child kobject during probe.",
    "aw_remove frees internal resources and returns without removing either sysfs group; target devres unregisters the LED child only after that return.",
    "A synchronous show can therefore run during aw_remove or remain in flight while teardown frees internal resources."
  ],
  "findings": [
    {
      "id": "HAP-SYSFS-03",
      "title": "synchronous sysfs show callbacks remain reachable during aw_remove",
      "severity": "high",
      "confidence": "high_static_reachability_and_callpath",
      "condition": "sysfs group creation succeeded and a show begins or remains active after aw_remove starts but before managed LED devres release",
      "exposure": "All 38 show callbacks are registered on the managed LED child, whose sysfs groups are removed only after aw_remove returns.",
      "confirmed_hardware_paths": [
        "ram_update_show dispatches through AW table slot 40 to aw8693x_get_ram_data, which reads I2C register 0x42 in chunks; ram_update_show has no mutex around this sequence.",
        "reg_show dispatches through slot 41 to aw8693x_get_reg, which performs I2C reads of three register ranges.",
        "loop_show dispatches through slot 39 to aw8693x_get_wav_loop, which reads register 0x12 and updates cached state fields.",
        "index_show and seq_show dispatch through slot 36 to aw8693x_get_wav_seq, which reads register 0x0a and writes sequence bytes into device state.",
        "prct_mode_show dispatches through slot 42 to aw8693x_get_prctmode, which reads register 0x4a."
      ],
      "other_observed_operations": "duration_show and duration_aw_show query an embedded hrtimer; f0_show, cali_show, and vbat_monitor_show use the shared device mutex, which aw_remove does not acquire.",
      "direct_async_submission": "No direct queue_work_on or request_firmware_nowait relocation appears in the 38 show bodies; the indirect function-table call graph is only expanded for the five listed I2C helpers.",
      "impact": "Show callbacks can access the device state and issue I2C operations while aw_remove is freeing internal state and dismantling hardware; several callbacks also write cached fields despite being sysfs show methods.",
      "relation_to_prior_findings": [
        "HAP-SYSFS-01",
        "HAP-SYSFS-02",
        "HAP-FW-01",
        "HAP-LED-01"
      ],
      "runtime_reproduced": false,
      "hardware_tested": false
    }
  ],
  "limits": [
    "This static review binds all 38 show callbacks to their exact candidate source and stock assembly hashes and binds five I2C helper bodies by source and assembly hashes.",
    "The 50-slot callback-table relocation audit is reused as an input; indirect helper chains beyond the five named I2C getters are not expanded.",
    "No runtime concurrency test, sanitizer, lockdep, or hardware reproduction was run.",
    "No source changed in this batch, so no Docker rebuild was required."
  ],
  "recommended_hardening_sequence": [
    "Remove or disable the LED sysfs groups and drain active show/store callbacks before aw_remove frees resources or begins bus teardown.",
    "Serialize hardware-facing show callbacks with the teardown gate; do not rely on the callback mutex unless aw_remove participates in the same protocol.",
    "Keep exact stock reconstruction separate from any hardening variant and validate source changes through the canonical Docker workspace."
  ]

  "teardown_ordering": [
    "vibrator_init registers the managed LED class device, then creates vibrator_attribute_group on the returned LED child device kobject.",
    "aw8693x_creat_node creates the AW-specific group on the same state+0xf8 LED child kobject.",
    "aw_remove cancels its currently queued work items and releases state-owned buffers/pages while both sysfs groups remain registered; its stock body does not remove these groups or acquire the sysfs mutex.",
    "The target driver core releases devres after aw_remove returns. The managed LED release unregisters the child and removes both sysfs groups only then.",
    "A store can therefore execute during aw_remove or remain in flight while it frees resources. The sysfs callback mutex does not serialize with aw_remove because the remove body takes no such mutex."
  ],
  "findings": [
    {
      "id": "HAP-SYSFS-02",
      "title": "synchronous LED sysfs stores are not quiesced before aw_remove resource teardown",
      "severity": "high",
      "confidence": "high_static_reachability_and_ordering",
      "condition": "the relevant sysfs groups were created and a userspace store begins or remains active after aw_remove starts but before the managed LED devres release",
      "exposure": "All 33 store callbacks are present in the two LED-child groups and resolve per-device state from the child drvdata. The groups remain registered until the managed child is unregistered after aw_remove returns.",
      "overlapping_effects": [
        "four stores can submit work on the two items that aw_remove cancels: activate_store and activate_aw_store target the same state+0x428 item; aw_rtp_store and rtp_auto_sin_store target the same state+0x3a0 item",
        "ram_update_store can submit the separate asynchronous ram_load firmware callback with raw state context",
        "other stores perform direct I2C, invoke hardware helper callbacks, modify shared state under a mutex not acquired by aw_remove, manipulate timers, or allocate/free callback-owned memory"
      ],
      "remove_behavior": "The exact stock aw_remove assembly contains no sysfs_remove_group, LED-child unregister, or mutex_lock call; it frees state-owned resources after early work cancellations.",
      "impact": "Synchronous callbacks may race resource release or hardware teardown, and the work/firmware submissions can outlive the store call and re-enter the already documented asynchronous lifetime paths.",
      "relation_to_prior_findings": [
        "HAP-SYSFS-01",
        "HAP-FW-01",
        "HAP-LED-01"
      ],
      "runtime_reproduced": false,
      "hardware_tested": false
    }
  ],
  "limits": [
    "This is a static reachability/order review bound to raw stock assembly, the reconstruction map, exact candidate source hashes, and target-kernel evidence from the parent review.",
    "Direct call targets are relocation-based. Indirect hardware operations are not expanded here into a whole-module call graph.",
    "Scheduler-dependent runtime manifestations, KASAN/KCSAN/lockdep, and hardware behavior were not tested.",
    "No candidate source changed in this batch; the canonical Docker source volume was verified present and read-only, and no rebuild was necessary."
  ],
  "recommended_hardening_sequence": [
    "In a separate hardening candidate, close admission to LED sysfs operations and unregister/remove the groups while state remains valid so active store callbacks are drained before freeing resources.",
    "Drain any work and firmware callbacks already submitted by in-flight stores; then cancel timers/work and destroy the per-device workqueue before releasing buffers or state.",
    "Keep the exact stock reconstruction and its map unchanged; version hardening separately and validate it through the canonical Docker workspace."
  ]
}

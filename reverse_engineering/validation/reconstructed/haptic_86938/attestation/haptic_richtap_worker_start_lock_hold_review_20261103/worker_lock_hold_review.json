  "findings": [
    {
      "id": "GLOBAL_MUTEX_HELD_DURING_RTP_START",
      "severity": "LATENCY_RISK",
      "details": "richtap_rtp_work acquires the global IRQ-stop mutex before calling richtap_rtp_start and retains it through the callback path until the common unlock. The IRQ wrapper uses the same mutex around the threaded stock handler.",
      "worker_lock_vma": "0x860c",
      "worker_rtp_start_call_vma": "0x861c",
      "worker_common_unlock_vma": "0x85c0",
      "irq_wrapper_lock_target": ".data+0x400",
      "irq_wrapper_body_call_vma": "0x752c"
    },
    {
      "id": "NESTED_DEVICE_MUTEX_AND_TIMEOUT_SLEEPS",
      "severity": "LATENCY_RISK",
      "details": "richtap_rtp_start acquires aw+0x2f0. It may poll global state 200 times with 2-2.5 ms requested sleeps; timeout calls aw8693x_stop before releasing aw+0x2f0. aw8693x_stop requests a 0.5-0.6 ms sleep and may poll 100 times with 2-2.5 ms requested sleeps.",
      "rtp_start_mutex_lock_vma": "0x80d0",
      "rtp_start_poll_sleep_vma": "0x8180",
      "rtp_start_timeout_loop_vma": "0x8184",
      "rtp_start_mutex_unlock_vma": "0x8214",
      "stop_initial_sleep_vma": "0x4b88",
      "stop_poll_sleep_vma": "0x4bf8",
      "stop_retry_loop_vma": "0x4bfc",
      "nominal_requested_sleep_total_ms_min": 602.5,
      "nominal_requested_sleep_total_ms_max": 752.6,
      "wall_clock_upper_bound_proven": false
    },
    {
      "id": "RTP_DATA_CALLBACK_UNDER_GLOBAL_MUTEX",
      "severity": "LATENCY_RISK",
      "details": "On successful RTP start, richtap_rtp_work calls set_rtp_data before releasing the global IRQ-stop mutex. The callback calls i2c_w_bytes with the copied RTP length, bounded by the worker validation to at most 16000 bytes; transfer time is not measured."
    },
    {
      "id": "SCOPED_LOCK_ORDER",
      "severity": "NO_CYCLE_ESTABLISHED_IN_REVIEWED_PATHS",
      "details": "The worker and reviewed serialized ioctl/stop-work paths use global IRQ-stop mutex before aw+0x2f0. The reviewed suspend, audio-off, RAM-number, and container-update functions take aw+0x2f0 without synchronously waiting for the RTP worker or acquiring the global mutex in those functions. This is not a whole-driver lockdep proof."
    }
  ],

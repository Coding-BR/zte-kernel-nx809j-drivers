        "stock_assembly_locations": [
          "richtap_file_unlocked_ioctl: command 0x520a dispatch at 0xb9a8-0xb9b0",
          "richtap_file_unlocked_ioctl: work pointer state+0x648 at 0xbac4-0xbacc",

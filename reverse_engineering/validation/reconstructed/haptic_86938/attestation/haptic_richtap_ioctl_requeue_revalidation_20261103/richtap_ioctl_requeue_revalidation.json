          "richtap_file_unlocked_ioctl: command 0x5212 selects state+0x668 at 0xb5d4-0xb5e0",
          "richtap_file_unlocked_ioctl: command 0x5213 log-and-return path at 0xb978-0xb9a4"
        ],
        "ghidra_decompilation_locations": [
          "0151_0010e374_richtap_file_unlocked_ioctl.c:148-190",
          "0151_0010e374_richtap_file_unlocked_ioctl.c:225-237"
        ]
      },
      {
        "stage": "remove_order",
        "evidence": "aw_remove calls cancel_work_sync(state+0x648), then frees the buffer at state+0x608 and the order-2 pages at state+0x610, and only afterward calls misc_deregister. No admission gate or wait for active ioctl calls is present in this path.",
        "stock_assembly_locations": [
          "aw_remove: cancel_work_sync(state+0x648) at 0x54ac-0x54b0",
          "aw_remove: kfree(*(state+0x608)) at 0x54b4-0x54b8",
          "aw_remove: free_pages(*(state+0x610), 2) at 0x54ec-0x54f4",
          "aw_remove: misc_deregister at 0x54f8-0x5500"
        ]
      },

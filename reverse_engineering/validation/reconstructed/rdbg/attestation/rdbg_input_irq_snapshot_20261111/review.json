  "conclusion": "The candidate statically pairs each open IRQ request with cleanup of the same per-open IRQ value. This addresses a mutable IRQ identity hazard; runtime safety across platform unbind/rebind is not established.",
  "trigger": {
    "stock_evidence": [
      "reverse_engineering/validation/reconstructed/rdbg/offline_static/ghidra_stock/rdbg.ko/pcode/0000_001004ac_rdbg_probe.jsonl",
      "reverse_engineering/validation/reconstructed/rdbg/offline_static/ghidra_stock/rdbg.ko/pcode/0003_00100ecc_rdbg_open.jsonl",
      "reverse_engineering/validation/reconstructed/rdbg/offline_static/ghidra_stock/rdbg.ko/pcode/0004_001014cc_rdbg_release.jsonl",
      "reverse_engineering/validation/reconstructed/rdbg/offline_static/stock_assembly/manifest.json"
    ],
    "observation": "Stock probe obtains an IRQ with of_irq_get_byname and publishes it in the client record; open requests the IRQ from that record. Candidate cleanup previously read the mutable record again, so a later probe update could make free_irq use a different identity than request_threaded_irq. This is a static race possibility, not a reproduced runtime failure."
  },
  "change": {
    "probe": "Writes to in.irq_base_id are protected by rdbg_input_irq_lock.",
    "open": "Copies in.irq_base_id into file_context->requested_irq under the same lock and passes the snapshot to request_threaded_irq and open-failure cleanup.",
    "release": "Calls free_irq with the per-open requested_irq snapshot."
  },

  "findings": [
    {
      "id": "RDBG-SMQ-001",
      "severity": "medium",
      "summary": "Concurrent reads through one shared character-device file can race on consumer SMQ indices.",
      "evidence": [
        "device_opened restricts opens, not concurrent read calls through a shared file description.",
        "The consumer SMQ is initialized without a lock pointer, and rdbg_read conditionally skips locking when that pointer is NULL.",
        "The pinned VFS sets FMODE_ATOMIC_POS only for regular files/directories; file position locking is therefore absent for this character device.",
        "ksys_read calls fdget_pos, but fdget_pos does not serialize this file because FMODE_ATOMIC_POS is unset."
      ],
      "interpretation": "With multiple pending completion tokens, concurrent read calls can race on index_sent_read, index_free_write, and free-node entries, causing duplicate/omitted packets or queue bookkeeping corruption. Static inference only; not reproduced."
    }
  ],
  "host_side_barrier_observations": [
    "Stock rdbg_read contains dsb ld before copying the received SMQ block.",
    "Stock rdbg_write serializes producer operations with its write mutex and executes the read barrier used in the free-node path.",
    "The pinned SMP2P provider calls wmb() before notifying the remote through mailbox/IPC after qcom_smem_state_update_bits."
  ],
  "protocol_limit": "These host-side barriers do not prove the remote firmware's matching memory-order protocol. No defect in the remote peer is asserted.",
  "reconstruction_disposition": "All observations match stock and the offline-exact candidate. No source or map change was made; keep rdbg offline-only and preserve exact mapping statuses.",

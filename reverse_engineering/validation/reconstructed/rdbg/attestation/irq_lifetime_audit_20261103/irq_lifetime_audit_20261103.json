  "findings": [
    {
      "id": "RDBG-IRQ-001",
      "severity": "high",
      "summary": "The requested per-open threaded IRQ is not freed on SMQ initialization failure or normal release.",
      "evidence": [
        "Stock open requests a non-shared threaded IRQ with dev_id pointing to the per-minor client record.",
        "The post-request smq_bail path destroys SMQ state and the mutex but has no free_irq call.",
        "Stock release wakes the completion, tears down SMQ/mutex state, and resets device_opened, but has no free_irq or synchronize_irq call.",
        "Stock handler calls complete on the completion inside the retained dev_id record.",
        "Stock module cleanup frees the clients array and also has no free_irq call."
      ],
      "interpretation": "The IRQ remains associated with the prior client and handler after the open state is closed. Later interrupts can target the old or reused completion; reclamation of client/module storage while registered creates a potential stale callback reference. This was not reproduced at runtime."
    },
    {
      "id": "RDBG-IRQ-002",
      "severity": "medium",
      "summary": "A later open of the same minor can fail when it tries to request the still-registered non-shared IRQ again.",
      "evidence": [
        "release resets device_opened to zero, so a subsequent open can reach request_threaded_irq again.",
        "The original and repeated requests use the same per-minor IRQ and dev_id and omit IRQF_SHARED.",
        "Pinned __setup_irq returns -EBUSY when an existing action cannot be shared."
      ],
      "interpretation": "Repeated open failure follows statically from the exact paths and pinned IRQ-core behavior; it was not exercised on hardware."
    }
  ],
